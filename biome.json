{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/.turbo", "!**/uniwind-types.d.ts", "!**/android", "!**/.expo"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["packages/engine/src/**", "packages/nutrition/src/**", "packages/catalogue/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "node:*",
                      "bun",
                      "bun:*",
                      "fs",
                      "fs/*",
                      "path",
                      "os",
                      "child_process",
                      "http",
                      "https",
                      "net",
                      "crypto",
                      "react",
                      "react/*",
                      "react-native",
                      "react-native-*",
                      "expo",
                      "expo-*",
                      "@expo/*",
                      "@powersync/*",
                      "drizzle-orm",
                      "drizzle-orm/*",
                      "hono",
                      "hono/*",
                      "ai",
                      "@openrouter/*",
                      "**/apps/**"
                    ],
                    "message": "engine, nutrition and catalogue are pure. They must not import apps or I/O libraries."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
