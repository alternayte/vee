{
  "expo": {
    "name": "Vee",
    "slug": "vee",
    "scheme": ["vee", "app.vee.mobile"],
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0e1114",
    "newArchEnabled": true,
    "android": {
      "package": "app.vee.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0e1114",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "ios": {
      "bundleIdentifier": "app.vee.mobile",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0e1114"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Vee uses the camera for your progress photos. They stay on this phone."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Vee uses your fingerprint or face to lock the Body tab and photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "36edb806-0600-4937-8e3b-3eab103bdcb5"
      }
    },
    "owner": "alternayte"
  }
}
