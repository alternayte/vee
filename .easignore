# EAS uploads with this file instead of every .gitignore. It repeats the
# .gitignore rules, except that it uploads apps/mobile/assets/clips (built by
# `just media`), so EAS builds have the exercise clips.
# `just check` fails when a .gitignore rule is missing here.

# .gitignore
.internal
.internal/
*.internal.*
.env*
!.env.example
node_modules
.turbo
dist
.claude/worktrees/
packages/ai/eval/out/

# apps/mobile/.gitignore
apps/mobile/node_modules/
apps/mobile/.expo/
apps/mobile/dist/
apps/mobile/web-build/
apps/mobile/expo-env.d.ts
apps/mobile/.kotlin/
apps/mobile/**/*.orig.*
apps/mobile/**/*.jks
apps/mobile/**/*.p8
apps/mobile/**/*.p12
apps/mobile/**/*.key
apps/mobile/**/*.mobileprovision
apps/mobile/**/.metro-health-check*
apps/mobile/**/npm-debug.*
apps/mobile/**/yarn-debug.*
apps/mobile/**/yarn-error.*
apps/mobile/**/.DS_Store
apps/mobile/**/*.pem
apps/mobile/**/.env*.local
apps/mobile/**/*.tsbuildinfo
apps/mobile/ios
apps/mobile/android
apps/mobile/modules/*/android/build/
