# SPDX-License-Identifier: AGPL-3.0-or-later
# Copy to .env next to compose.yaml and fill in. Never commit the filled file.

# Postgres superuser password (app, PowerSync storage and GlitchTip databases).
POSTGRES_PASSWORD=

# Better Auth: 32 or more random characters.
BETTER_AUTH_SECRET=
# Public URL of the API, for example https://api.example.ch
API_BASE_URL=
# Passkey relying party: the base domain, for example example.ch. Do not change it later.
PASSKEY_RP_ID=
# The first account with this email becomes the instance owner.
OWNER_EMAIL=
# Billing stays off for personal use: every signed-in user gets the plus tier.
BILLING_ENABLED=false
# SHA-256 fingerprints of the Android signing keys, comma-separated (for assetlinks.json).
ANDROID_CERT_SHA256=

# Mail for magic links and export links, for example smtps://user:pass@smtp.example.ch:465
SMTP_URL=
MAIL_FROM=Vee <no-reply@example.ch>

# GlitchTip error reports.
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DOMAIN=https://glitchtip.example.ch
